---
import Layout from "./Layout.astro";
---

<Layout>
  <main class="min-h-dvh">
    <nav class="border-b-2 border-b-neutral-300 bg-white px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between text-sm">
        <a
          href={import.meta.env.BASE_URL}
          class="font-bold text-blue-500 hover:text-blue-600">PyJudge</a
        >
        <span class="text-neutral-500">Algorithms / Lecture 02</span>
      </div>
    </nav>
    <article class="prose prose-neutral mx-auto max-w-4xl px-6 py-8">
      <slot />
    </article>
  </main>
</Layout>
