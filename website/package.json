{
  "name": "python-training-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "prettier --check \"src/**/*.{ts,astro,md,css}\" && eslint \"src/**/*.ts\"",
    "format": "prettier --log-level warn --write \"src/**/*.{ts,astro,md,css}\"",
    "test": "vitest run",
    "test-ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality_gate": "pnpm lint && pnpm exec astro check src && pnpm test-coverage && pnpm build",
    "test-coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.0",
    "astro": "^5.1.8",
    "katex": "^0.16.22",
    "pyodide": "^0.27.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.24.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript-eslint": "^8.29.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "vite-plugin-static-copy": "^2.3.1",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@10.15.0"
}
